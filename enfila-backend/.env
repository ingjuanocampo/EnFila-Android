# Twilio Configuration
# Replace with your actual Twilio credentials
TWILIO_SID=your_twilio_account_sid_here
TWILIO_TOKEN=your_twilio_auth_token_here

# Database Configuration (these match docker-compose.yml)
DATABASE_URL=jdbc:postgresql://postgres:5432/enfila_db
DATABASE_USER=enfila_user
DATABASE_PASSWORD=enfila_password
